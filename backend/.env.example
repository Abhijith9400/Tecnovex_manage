# Runtime
NODE_ENV=development
PORT=4000

# Allowed frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose.yml defaults; change for production)
DATABASE_URL=postgresql://agency:agency_dev_password@localhost:5432/agency_management?schema=public

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# File storage
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500

# Cookie SameSite policy: lax (same site), or none (+HTTPS) if frontend and API are on different sites
COOKIE_SAMESITE=lax

# Seed (npm run db:seed). If SEED_ADMIN_PASSWORD is empty a random one is generated and printed once.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_DATA=true

# Separate database used by npm test (wiped on every run)
TEST_DATABASE_URL=postgresql://agency:agency_dev_password@localhost:5432/agency_management_test?schema=public

# Master switch for the emailed sign-in code. When true, admins turn it on/off in Settings → Security; false forces it off.
LOGIN_OTP_ENABLED=true

# Outgoing email (SMTP). Leave SMTP_HOST empty in development to print emails/codes in the backend console.
# Examples: Gmail/Google Workspace smtp.gmail.com:587 (use an App Password), Zoho smtp.zoho.in:587,
# Microsoft 365 smtp.office365.com:587, Amazon SES email-smtp.ap-south-1.amazonaws.com:587, Brevo smtp-relay.brevo.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tecnovex Digital <no-reply@yourdomain.com>
