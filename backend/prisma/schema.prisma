// Agency Management & Creative Hub - database schema
// Money is always Decimal (PostgreSQL numeric). Never use Float for currency.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // everything, including payroll and user management
  ACCOUNTANT // finance: invoices, payments, expenses, income, reports (no payroll)
  MANAGER // operations: clients, creatives, agreements, projects (no finance)
  EMPLOYEE // own payslips only
  CLIENT // client portal: own approved/published creatives only
}

enum ClientStatus {
  LEAD
  ACTIVE
  ON_HOLD
  INACTIVE
}

enum BillingType {
  RETAINER
  PROJECT
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

enum AgreementStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum CreativeType {
  POSTER
  CAROUSEL
  VIDEO
  REEL
  STORY
  OTHER
}

enum CreativePlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  YOUTUBE
  X
  WEBSITE
  OTHER
}

enum CreativeStatus {
  DRAFT
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum FileCategory {
  CREATIVE
  AGREEMENT
  PAYMENT_PROOF
  EXPENSE_RECEIPT
  INCOME_ATTACHMENT
  BRANDING
  CONTENT_CALENDAR
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceLayout {
  CLASSIC
  MODERN
  MINIMAL
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
  CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum DeductionBasis {
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  FIXED
}

enum PayrollStatus {
  PENDING
  APPROVED
  PAID
}

enum PayrollLineType {
  EARNING
  DEDUCTION
}

enum CategoryType {
  EXPENSE
  INCOME
}

// ---------------------------------------------------------------------------
// Users & settings
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(MANAGER)
  isActive     Boolean   @default(true)
  /// Incremented on password change / logout-all to invalidate existing sessions.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Client portal logins are linked to exactly one client (several logins per client are allowed).
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs          AuditLog[]
  uploadedFiles      StoredFile[]
  createdInvoices    Invoice[]           @relation("InvoiceCreatedBy")
  recordedPayments   Payment[]           @relation("PaymentRecordedBy")
  expenses           Expense[]
  incomeEntries      IncomeEntry[]
  approvedPayrolls   PayrollRecord[]     @relation("PayrollApprovedBy")
  payrollAdjustments PayrollAdjustment[]
  creatives          CreativeAsset[]
  managedCampaigns   AdCampaign[]
  workLogsCreated    WorkLog[]
  tasksAssigned      Task[]              @relation("TaskAssignedBy")
  taskComments       TaskComment[]
  calendarEvents     CalendarEvent[]
  loginChallenges    LoginChallenge[]
  approvalRequests   ApprovalRequest[]   @relation("ApprovalRequestedBy")
  approvalsReviewed  ApprovalRequest[]   @relation("ApprovalReviewedBy")
  contentCalendars   ContentCalendar[]
}

/// Singleton row (id = 1).
model CompanySettings {
  id                      Int              @id @default(1)
  legalName               String           @default("")
  tradingName             String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String           @default("India")
  email                   String?
  phone                   String?
  website                 String?
  pan                     String?
  /// Do not assume GST registration; tax fields only appear on invoices when enabled.
  isGstRegistered         Boolean          @default(false)
  gstin                   String?
  taxLabel                String           @default("GST")
  defaultTaxRate          Decimal          @default(0) @db.Decimal(5, 2)
  /// When true, PDFs show the tax split into two equal halves (e.g. CGST + SGST).
  splitTaxOnInvoice       Boolean          @default(false)
  otherTaxInfo            String?
  bankName                String?
  bankAccountName         String?
  bankAccountNumber       String?
  bankIfsc                String?
  bankBranch              String?
  upiId                   String?
  currency                String           @default("INR")
  invoicePrefix           String           @default("INV")
  invoiceNumberPadding    Int              @default(4)
  /// Adds the Indian financial year (e.g. 2026-27) to invoice numbers and restarts numbering each year.
  invoiceUseFinancialYear Boolean          @default(true)
  receiptPrefix           String           @default("RCPT")
  defaultPaymentTermsDays Int              @default(15)
  paymentTermsText        String?
  invoiceNotes            String?
  logoFileId              String?          @unique
  logoFile                StoredFile?      @relation("CompanyLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  activeTemplateId        String?
  activeTemplate          InvoiceTemplate? @relation(fields: [activeTemplateId], references: [id], onDelete: SetNull)
  /// Admin switch for the emailed sign-in code. LOGIN_OTP_ENABLED=false in .env turns it off regardless.
  loginOtpEnabled         Boolean          @default(true)
  updatedAt               DateTime         @updatedAt
}

model InvoiceTemplate {
  id              String        @id @default(uuid())
  name            String
  layout          InvoiceLayout @default(CLASSIC)
  primaryColor    String        @default("#172554")
  accentColor     String        @default("#F97316")
  headerText      String?
  footerText      String?
  termsText       String?
  showLogo        Boolean       @default(true)
  showBankDetails Boolean       @default(true)
  showSignature   Boolean       @default(true)
  signatureLabel  String        @default("Authorised Signatory")
  signatureFileId String?       @unique
  signatureFile   StoredFile?   @relation("TemplateSignature", fields: [signatureFileId], references: [id], onDelete: SetNull)
  /// Optional uploaded reference design (PDF/image) kept for comparison.
  referenceFileId String?       @unique
  referenceFile   StoredFile?   @relation("TemplateReference", fields: [referenceFileId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoices  Invoice[]
  activeFor CompanySettings[]
}

/// Atomic counters for document numbers, keyed like "invoice:2026-27" or "receipt".
model NumberSequence {
  key       String @id
  nextValue Int    @default(1)
}

model Category {
  id        String       @id @default(uuid())
  type      CategoryType
  name      String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  expenses      Expense[]
  incomeEntries IncomeEntry[]

  @@unique([type, name])
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

/// Metadata for files kept in the storage backend (never the binary itself).
model StoredFile {
  id           String       @id @default(uuid())
  category     FileCategory
  storageKey   String       @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  creativeAssetId String?
  creativeAsset   CreativeAsset?   @relation(fields: [creativeAssetId], references: [id], onDelete: Cascade)
  sortOrder       Int              @default(0)
  agreementId     String?
  agreement       ClientAgreement? @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  label           String?

  companyLogo       CompanySettings? @relation("CompanyLogo")
  templateSignature InvoiceTemplate? @relation("TemplateSignature")
  templateReference InvoiceTemplate? @relation("TemplateReference")
  paymentProof      Payment?         @relation("PaymentProof")
  expenseReceipt    Expense?         @relation("ExpenseReceipt")
  incomeAttachment  IncomeEntry?     @relation("IncomeAttachment")
  contentCalendar   ContentCalendar? @relation("ContentCalendarFile")

  @@index([creativeAssetId])
  @@index([agreementId])
}

// ---------------------------------------------------------------------------
// Clients, services, agreements, projects, creatives
// ---------------------------------------------------------------------------

model Client {
  id               String       @id @default(uuid())
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String       @default("India")
  pan              String?
  gstin            String?
  billingType      BillingType  @default(RETAINER)
  monthlyRetainer  Decimal?     @db.Decimal(14, 2)
  projectPrice     Decimal?     @db.Decimal(14, 2)
  billingCycle     BillingCycle @default(MONTHLY)
  paymentTermsDays Int          @default(15)
  status           ClientStatus @default(ACTIVE)
  notes            String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  services         Service[]
  agreements       ClientAgreement[]
  projects         Project[]
  creatives        CreativeAsset[]
  invoices         Invoice[]
  payments         Payment[]
  auditLogs        AuditLog[]
  portalUsers      User[]
  adCampaigns      AdCampaign[]
  workLogs         WorkLog[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  contentCalendars ContentCalendar[]

  @@index([name])
  @@index([status])
}

/// A service the agency provides to a client. Recurring services drive monthly invoice generation.
model Service {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name        String
  description String?
  sacCode     String?
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  isRecurring Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@index([clientId])
}

model ClientAgreement {
  id                  String          @id @default(uuid())
  clientId            String
  client              Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title               String
  reference           String?
  effectiveDate       DateTime        @db.Date
  expiryDate          DateTime?       @db.Date
  contractValue       Decimal?        @db.Decimal(14, 2)
  status              AgreementStatus @default(DRAFT)
  scopeOfWork         String?
  monthlyDeliverables String?
  postsPerMonth       Int?
  carouselsPerMonth   Int?
  reelsPerMonth       Int?
  revisionLimit       Int?
  exclusions          String?
  paymentTerms        String?
  renewalReminderDays Int             @default(30)
  notes               String?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  documents StoredFile[]
  projects  Project[]

  @@index([clientId])
  @@index([expiryDate])
}

model Project {
  id          String           @id @default(uuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  agreementId String?
  agreement   ClientAgreement? @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  name        String
  description String?
  status      ProjectStatus    @default(PLANNED)
  startDate   DateTime?        @db.Date
  endDate     DateTime?        @db.Date
  budget      Decimal?         @db.Decimal(14, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  creatives   CreativeAsset[]
  adCampaigns AdCampaign[]

  @@index([clientId])
}

model CreativeAsset {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId     String?
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title         String
  campaign      String?
  contentType   CreativeType
  platform      CreativePlatform @default(INSTAGRAM)
  status        CreativeStatus   @default(DRAFT)
  publishDate   DateTime?        @db.Date
  caption       String?
  internalNotes String?
  uploadedById  String?
  uploadedBy    User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  files       StoredFile[]
  adCampaigns AdCampaign[]

  @@index([clientId, createdAt])
  @@index([campaign])
}

// ---------------------------------------------------------------------------
// Invoicing & payments
// ---------------------------------------------------------------------------

model Invoice {
  id            String           @id @default(uuid())
  /// Assigned when the invoice is issued. Drafts have no number.
  invoiceNumber String?          @unique
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  templateId    String?
  template      InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Billing month as "YYYY-MM" when the invoice covers a period.
  billingPeriod String?
  /// "<clientId>:<YYYY-MM>" for invoices generated from recurring services. Cleared on cancel so the period can be re-billed.
  recurringKey  String?          @unique
  issueDate     DateTime         @db.Date
  dueDate       DateTime         @db.Date
  status        InvoiceStatus    @default(DRAFT)
  currency      String           @default("INR")

  billToName      String
  billToAddress   String?
  billToEmail     String?
  billToGstin     String?
  billToPan       String?
  /// Company details frozen at the moment of issue so reprints match the original.
  companySnapshot Json?

  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  total         Decimal @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal @default(0) @db.Decimal(14, 2)

  notes         String?
  terms         String?
  issuedAt      DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  revisedFromId String?   @unique
  revisedFrom   Invoice?  @relation("InvoiceRevision", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisedBy     Invoice?  @relation("InvoiceRevision")
  createdById   String?
  createdBy     User?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([clientId, billingPeriod])
  @@index([status, dueDate])
  @@index([issueDate])
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description   String
  sacCode       String?
  quantity      Decimal  @db.Decimal(12, 2)
  unitPrice     Decimal  @db.Decimal(14, 2)
  /// Flat discount amount for the line.
  discount      Decimal  @default(0) @db.Decimal(14, 2)
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  lineSubtotal  Decimal  @db.Decimal(14, 2)
  taxableAmount Decimal  @db.Decimal(14, 2)
  taxAmount     Decimal  @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  sortOrder     Int      @default(0)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(uuid())
  receiptNumber  String        @unique
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentDate    DateTime      @db.Date
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  /// "<METHOD>:<normalised reference>" for recorded payments; cleared on void. Blocks the same transaction being entered twice.
  referenceKey   String?       @unique
  /// Client-generated key per form submission; prevents double-submits creating two payments.
  idempotencyKey String?       @unique
  notes          String?
  status         PaymentStatus @default(RECORDED)
  voidedAt       DateTime?
  voidReason     String?
  proofFileId    String?       @unique
  proofFile      StoredFile?   @relation("PaymentProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  recordedById   String?
  recordedBy     User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([clientId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// ---------------------------------------------------------------------------
// Employees & payroll
// ---------------------------------------------------------------------------

model Employee {
  id                String           @id @default(uuid())
  employeeCode      String           @unique
  fullName          String
  email             String?          @unique
  phone             String?
  designation       String?
  department        String?
  joiningDate       DateTime         @db.Date
  exitDate          DateTime?        @db.Date
  status            EmploymentStatus @default(ACTIVE)
  pan               String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user             User?
  salaryStructures SalaryStructure[]
  payrollRecords   PayrollRecord[]
  workLogs         WorkLog[]
  tasks            Task[]
  calendarInvites  CalendarEventAttendee[]
}

/// Salary history: a new row per revision; the row in force for a month is the latest effectiveFrom on or before it.
model SalaryStructure {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  effectiveFrom   DateTime @db.Date
  basic           Decimal  @db.Decimal(14, 2)
  allowances      Decimal  @default(0) @db.Decimal(14, 2)
  otherEarnings   Decimal  @default(0) @db.Decimal(14, 2)
  fixedDeductions Decimal  @default(0) @db.Decimal(14, 2)
  applyStatutory  Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())

  payrollRecords PayrollRecord[]

  @@unique([employeeId, effectiveFrom])
}

/// Configurable statutory deduction rules (e.g. PF, ESI, professional tax). Nothing is assumed by default.
model StatutoryDeduction {
  id        String         @id @default(uuid())
  name      String         @unique
  basis     DeductionBasis
  value     Decimal        @db.Decimal(14, 2)
  /// Optional cap on the computed amount.
  maxAmount Decimal?       @db.Decimal(14, 2)
  isActive  Boolean        @default(true)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PayrollRecord {
  id                String           @id @default(uuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryStructureId String?
  salaryStructure   SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  periodYear        Int
  periodMonth       Int
  grossEarnings     Decimal          @db.Decimal(14, 2)
  totalDeductions   Decimal          @db.Decimal(14, 2)
  netPay            Decimal          @db.Decimal(14, 2)
  status            PayrollStatus    @default(PENDING)
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?            @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidAt            DateTime?        @db.Date
  paymentMethod     PaymentMethod?
  paymentReference  String?
  notes             String?
  /// Month-specific inputs (incentives, extra earnings/deductions) so a pending record can be recalculated.
  monthInputs       Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  lines       PayrollLine[]
  adjustments PayrollAdjustment[]

  @@unique([employeeId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model PayrollLine {
  id              String          @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord   @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            PayrollLineType
  label           String
  amount          Decimal         @db.Decimal(14, 2)
  sortOrder       Int             @default(0)

  @@index([payrollRecordId])
}

/// Auditable correction to a paid payroll record. Positive = additional pay, negative = recovery.
model PayrollAdjustment {
  id               String         @id @default(uuid())
  payrollRecordId  String
  payrollRecord    PayrollRecord  @relation(fields: [payrollRecordId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(14, 2)
  reason           String
  paidAt           DateTime?      @db.Date
  paymentMethod    PaymentMethod?
  paymentReference String?
  createdById      String?
  createdBy        User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([payrollRecordId])
}

// ---------------------------------------------------------------------------
// Expenses & other income
// ---------------------------------------------------------------------------

model Expense {
  id            String        @id @default(uuid())
  title         String
  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(14, 2)
  expenseDate   DateTime      @db.Date
  vendor        String?
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  receiptFileId String?       @unique
  receiptFile   StoredFile?   @relation("ExpenseReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([expenseDate])
  @@index([categoryId])
}

/// Income NOT received through invoice payments (e.g. interest, refunds, grants).
model IncomeEntry {
  id               String        @id @default(uuid())
  description      String
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount           Decimal       @db.Decimal(14, 2)
  incomeDate       DateTime      @db.Date
  source           String?
  paymentMethod    PaymentMethod
  reference        String?
  notes            String?
  attachmentFileId String?       @unique
  attachmentFile   StoredFile?   @relation("IncomeAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([incomeDate])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  /// Set when the change relates to a client, to build the client Activity tab.
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  summary    String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([clientId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Ad campaigns & employee work log
// ---------------------------------------------------------------------------

enum AdPlatform {
  META // Facebook + Instagram via Meta Ads
  GOOGLE
  YOUTUBE
  LINKEDIN
  X
  OTHER
}

enum AdCampaignType {
  POST_BOOST
  REEL_BOOST
  STORY_BOOST
  ADS_MANAGER_CAMPAIGN
  LEAD_GENERATION
  SEARCH_ADS
  DISPLAY_ADS
  VIDEO_ADS
  OTHER
}

enum AdCampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Whose money paid the ad platform. Agency-paid spend is NOT turned into an expense automatically.
enum AdSpendSource {
  CLIENT_ACCOUNT
  AGENCY_PAID
}

/// A paid campaign or boost run for a client, with its spend and results (entered from the ad platform).
model AdCampaign {
  id           String           @id @default(uuid())
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creativeId   String?
  creative     CreativeAsset?   @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  name         String
  platform     AdPlatform
  campaignType AdCampaignType
  objective    String?
  status       AdCampaignStatus @default(PLANNED)
  startDate    DateTime         @db.Date
  endDate      DateTime?        @db.Date
  budget       Decimal?         @db.Decimal(14, 2)
  spend        Decimal          @default(0) @db.Decimal(14, 2)
  paidFrom     AdSpendSource    @default(CLIENT_ACCOUNT)
  impressions  Int              @default(0)
  reach        Int              @default(0)
  clicks       Int              @default(0)
  results      Int              @default(0)
  /// What a result means for this campaign, e.g. Leads, Messages, Link clicks, ThruPlays.
  resultLabel  String?
  /// Link to the boosted post/reel (e.g. Instagram or Facebook URL), for boosts of posts not in the Creative Shelf.
  postUrl      String?
  /// Campaign / post ID on the ad platform, for cross-reference.
  externalId   String?
  notes        String?
  managedById  String?
  managedBy    User?            @relation(fields: [managedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId, startDate])
  @@index([startDate])
}

enum WorkTaskType {
  DESIGN
  VIDEO_EDITING
  CONTENT_WRITING
  SOCIAL_MEDIA_MANAGEMENT
  ADS_MANAGEMENT
  PHOTOGRAPHY
  STRATEGY
  CLIENT_MEETING
  REVISIONS
  ADMIN
  OTHER
}

/// Time spent by an employee on a task, optionally for a client. Stored in whole minutes.
model WorkLog {
  id          String       @id @default(uuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  workDate    DateTime     @db.Date
  minutes     Int
  taskType    WorkTaskType
  title       String
  description String?
  /// Optional task this time was spent on.
  taskId      String?
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([taskId])
  @@index([employeeId, workDate])
  @@index([clientId, workDate])
  @@index([workDate])
}

// ---------------------------------------------------------------------------
// Task assignment
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Work assigned to an employee by an admin or manager.
model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId     String
  assignee       Employee     @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedById   String?
  assignedBy     User?        @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  taskType       WorkTaskType @default(OTHER)
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?    @db.Date
  estimatedHours Decimal?     @db.Decimal(6, 2)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments TaskComment[]
  workLogs WorkLog[]

  @@index([assigneeId, status])
  @@index([clientId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

enum CalendarEventType {
  POST_SCHEDULE // posting / publishing date
  DESIGN_DEADLINE
  CLIENT_SUBMISSION // sending work to the client
  SHOOT
  MEETING
  CAMPAIGN_LAUNCH
  FESTIVAL // festival / occasion to plan content around
  OTHER
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// A calendar event. Timed events store exact instants; all-day events store the first and last day at UTC
/// midnight (end is inclusive). Repeating events are expanded into occurrences when a date range is read.
model CalendarEvent {
  id                 String              @id @default(uuid())
  title              String
  description        String?
  location           String?
  eventType          CalendarEventType   @default(OTHER)
  /// Optional colour override (hex); otherwise the event type's colour is used.
  color              String?
  clientId           String?
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  allDay             Boolean             @default(false)
  startAt            DateTime
  endAt              DateTime
  recurrence         RecurrenceFrequency @default(NONE)
  recurrenceInterval Int                 @default(1)
  recurrenceUntil    DateTime?           @db.Date
  /// Dates (YYYY-MM-DD of the occurrence start) removed from a repeating series.
  excludedDates      String[]
  createdById        String?
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attendees CalendarEventAttendee[]

  @@index([startAt])
  @@index([clientId, startAt])
}

model CalendarEventAttendee {
  eventId    String
  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([eventId, employeeId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Email one-time passwords (sign-in verification)
// ---------------------------------------------------------------------------

/// A pending sign-in after a correct password. Only an HMAC of the 6-digit code is stored.
model LoginChallenge {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// LOGIN = second step of sign-in; PASSWORD_RESET = "forgot password". A code only works for its own purpose.
  purpose    ChallengePurpose @default(LOGIN)
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  sendCount  Int              @default(1)
  lastSentAt DateTime         @default(now())
  consumedAt DateTime?
  ipAddress  String?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
}

enum ChallengePurpose {
  LOGIN
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Approvals
// ---------------------------------------------------------------------------

enum ApprovalKind {
  PAYMENT // client payment entered by a manager
  EXPENSE // expense entered by a manager
  PAYROLL_PAYMENT // payroll marked paid by a manager
  DELETE // delete requested by an employee
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Something a user asked to do that needs sign-off. Nothing happens until it is approved; approving runs the
/// original action as the approver, so totals, balances and numbering are only affected by approved entries.
model ApprovalRequest {
  id             String         @id @default(uuid())
  kind           ApprovalKind
  status         ApprovalStatus @default(PENDING)
  /// Human-readable summary, e.g. "Payment of 15,000.00 from Acme Foods".
  title          String
  /// For DELETE: what to delete (e.g. "Task" + id). For PAYROLL_PAYMENT: the payroll record.
  entityType     String?
  entityId       String?
  /// The original request body (payment/expense fields, payroll pay details, delete options).
  payload        Json
  amount         Decimal?       @db.Decimal(14, 2)
  /// Uploaded proof/receipt, stored when the request was made and attached on approval.
  attachmentId   String?
  idempotencyKey String?        @unique
  requestedById  String
  requestedBy    User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById   String?
  reviewedBy     User?          @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  /// Id of the record created on approval (payment or expense).
  resultId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, kind])
  @@index([requestedById])
}

// ---------------------------------------------------------------------------
// Content calendars (shared with the client)
// ---------------------------------------------------------------------------

enum ContentCalendarKind {
  UPLOADED // a file the team prepared (PDF, Excel, Word, image)
  GENERATED // a PDF built from the app calendar each time it is opened
}

/// A client's content plan for one month, either an uploaded file or generated from the calendar.
model ContentCalendar {
  id               String              @id @default(uuid())
  clientId         String
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Month as YYYY-MM.
  period           String
  title            String
  notes            String?
  kind             ContentCalendarKind
  fileId           String?             @unique
  file             StoredFile?         @relation("ContentCalendarFile", fields: [fileId], references: [id], onDelete: SetNull)
  /// Visible and downloadable in the client portal.
  sharedWithClient Boolean             @default(true)
  createdById      String?
  createdBy        User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([clientId, period])
}
